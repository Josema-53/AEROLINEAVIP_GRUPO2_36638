@model AerolineaVIP.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Recuperar contraseña";
}

<main aria-labelledby="title">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 id="title">@ViewBag.Title</h2>
            <p class="text-muted">Ingrese el correo o el nombre de usuario con el que se registró.</p>

            @if (ViewBag.Mensaje != null)
            {
                <div class="alert alert-info" role="status">@ViewBag.Mensaje</div>
            }

            @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="mb-3">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", autocomplete = "username" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                </div>
                <button type="submit" class="btn btn-primary">Enviar instrucciones</button>
                @Html.ActionLink("Volver al inicio de sesión", "Login", "Account", null, new { @class = "btn btn-link" })
            }
        </div>
    </div>
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
