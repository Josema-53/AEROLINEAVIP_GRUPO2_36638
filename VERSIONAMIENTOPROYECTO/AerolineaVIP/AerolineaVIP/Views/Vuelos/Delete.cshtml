@model AerolineaVIP.Models.Vuelo

@{
    ViewBag.Title = "Eliminar · Vuelos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Eliminar</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}
<h3>¿Está seguro de que desea eliminar este registro?</h3>
<div>
    <h4>Vuelo</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.FechaOperacion)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.FechaOperacion)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Aeronave.Matricula)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Aeronave.Matricula)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.EstadoVuelo.Descripcion)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.EstadoVuelo.Descripcion)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Frecuencia.FrecuenciaId)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Frecuencia.FrecuenciaId)
        </dd>

    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Eliminar" class="btn btn-default" /> |
            @Html.ActionLink("Volver a la lista", "Index")
        </div>
    }
</div>
