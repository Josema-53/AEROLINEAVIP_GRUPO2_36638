@model List<string[]>
@{
    ViewBag.Title = "Conflictos de aeronave";
}

@Html.Partial("_TabsVuelos", "Vuelos/Conflictos")
<h2>Conflictos de aeronave</h2>
<p class="text-muted">
    Vuelos asignados a la misma aeronave cuyos intervalos operativos se cruzan, considerando @ViewBag.Margen minutos
    de preparación antes de la salida y después de la llegada (DP-03). Se revisan los vuelos desde hace 7 días.
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-success">No hay conflictos de asignación.</div>
}
else
{
    <table class="table">
        <tr><th>Aeronave</th><th>Vuelo</th><th>En conflicto con</th></tr>
        @foreach (var c in Model)
        {
            <tr><td>@c[0]</td><td>@c[1]</td><td>@c[2]</td></tr>
        }
    </table>
}
@Html.ActionLink("Volver a vuelos", "Index", null, new { @class = "btn btn-outline-dark" })
