@model AerolineaVIP.Models.EditarUsuarioViewModel
@{
    ViewBag.Title = "Editar usuario";
}

@Html.Partial("_TabsGestion", "Admin/Usuarios")
<h2>Editar usuario</h2>

@Html.ValidationSummary(true, "", new { @class = "text-danger", role = "alert" })

@using (Html.BeginForm("EditarUsuario", "Admin", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    <div class="mb-3" style="max-width: 520px;">
        @Html.LabelFor(m => m.UserName, new { @class = "form-label" })
        <p class="form-control-plaintext">@Model.UserName</p>
    </div>
    <div class="mb-3" style="max-width: 520px;">
        @Html.LabelFor(m => m.Nombres, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Nombres, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Nombres, "", new { @class = "text-danger" })
    </div>
    <div class="mb-3" style="max-width: 520px;">
        @Html.LabelFor(m => m.Apellidos, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Apellidos, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Apellidos, "", new { @class = "text-danger" })
    </div>
    <div class="mb-3" style="max-width: 520px;">
        @Html.LabelFor(m => m.Email, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-dark">Guardar cambios</button>
    @Html.ActionLink("Cancelar", "Usuarios", "Admin", null, new { @class = "btn btn-outline-secondary" })
}
