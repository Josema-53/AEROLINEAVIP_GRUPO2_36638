@model List<string[]>
@{
    ViewBag.Title = "Usuarios";
    var roles = (string[])ViewBag.Roles;
    bool esSuperUsuario = User.IsInRole("SuperUsuario");
}

@Html.Partial("_TabsGestion", "Admin/Usuarios")
<h2>Usuarios</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success" role="alert">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}

<form method="get" class="mb-4">
    <div class="row">
        <div class="col-md-5">
            <label>Buscar (usuario, correo o nombre):</label>
            <input type="text" name="buscar" value="@Request.QueryString["buscar"]" class="form-control" />
        </div>
        <div class="col-md-3">
            <label>Rol:</label>
            @Html.DropDownList("rol", (SelectList)ViewBag.rol, "-- Todos --", new { @class = "form-control" })
        </div>
    </div>
    <div class="row mt-2" style="margin-top: 10px; margin-bottom: 20px;">
        <div class="col-md-12">
            <button type="submit" class="btn btn-primary">Consultar</button>
            <a href="@Url.Action("Usuarios")" class="btn btn-secondary">Limpiar Filtros</a>
        </div>
    </div>
</form>

@if (esSuperUsuario)
{
    <p>@Html.ActionLink("Crear cuenta de usuario", "Register", "Account")</p>
}
else
{
    <div class="alert alert-secondary">Solo el SuperUsuario puede crear cuentas con roles y asignar roles.</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">No se encontraron registros.</div>
}
<table class="table">
    <tr>
        <th>Usuario</th>
        <th>Correo</th>
        <th>Nombre</th>
        <th>Rol</th>
        <th>Estado</th>
        @if (esSuperUsuario)
        {
            <th>Asignar rol</th>
        }
    </tr>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u[1]</td>
            <td>@u[2]</td>
            <td>@u[3]</td>
            <td>@u[4]</td>
            <td>@u[5]</td>
            @if (esSuperUsuario)
            {
                <td>
                    @using (Html.BeginForm("AsignarRol", "Admin", FormMethod.Post, new { @class = "d-flex gap-1" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="usuarioId" value="@u[0]" />
                        <select name="rol" class="form-select form-select-sm" aria-label="Rol de @u[1]">
                            @foreach (var r in roles)
                            {
                                <option value="@r" @(u[4] == r ? "selected" : "")>@r</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-dark">Asignar</button>
                    }
                </td>
            }
        </tr>
    }
</table>
