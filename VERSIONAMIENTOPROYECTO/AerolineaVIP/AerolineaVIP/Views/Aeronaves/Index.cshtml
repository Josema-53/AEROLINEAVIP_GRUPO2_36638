@model IEnumerable<AerolineaVIP.Models.Aeronave>
@{
    ViewBag.Title = "Aeronaves";
    var proximos = (Dictionary<int, int>)ViewBag.Proximos;
}

<h2>Administración de aeronaves</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-warning" role="alert">@TempData["Mensaje"]</div>
}

<p>
    @Html.ActionLink("Crear nueva", "Create") |
    @Html.ActionLink("Modelos de aeronave", "Index", "ModeloAeronaves")
</p>
<table class="table">
    <tr>
        <th>Identificador</th>
        <th>Modelo</th>
        <th>Capacidad</th>
        <th>Estado</th>
        <th>Vuelos próximos</th>
        <th></th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Matricula</td>
            <td>@item.ModeloAeronave.Fabricante @item.ModeloAeronave.Nombre</td>
            <td>@item.ModeloAeronave.CapacidadAsientos</td>
            <td>@item.EstadoAeronave.Descripcion</td>
            <td>@(proximos.ContainsKey(item.AeronaveId) ? proximos[item.AeronaveId] : 0)</td>
            <td>
                @Html.ActionLink("Consultar", "Details", new { id = item.AeronaveId }) |
                @Html.ActionLink("Modificar estado", "Edit", new { id = item.AeronaveId }) |
                @Html.ActionLink("Eliminar", "Delete", new { id = item.AeronaveId })
            </td>
        </tr>
    }
</table>
