            @Html.DisplayFor(modelItem => item.Nombre)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.LongitudNumero)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.LongitudCodigoSeguridad)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PrefijosReferencia)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.RutaLogo)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Activa)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.Codigo }) |
            @Html.ActionLink("Details", "Details", new { id=item.Codigo }) |
