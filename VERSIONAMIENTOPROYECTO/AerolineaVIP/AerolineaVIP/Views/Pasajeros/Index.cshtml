@model IEnumerable<AerolineaVIP.Models.Pasajero>
@{
    ViewBag.Title = "Pasajeros";
}

@Html.Partial("_TabsGestion", "Pasajeros/Index")
<h2>Pasajeros</h2>

<form method="get" class="mb-4">
    <div class="row">
        <div class="col-md-5">
            <label>Buscar (documento, nombres o apellidos):</label>
            <input type="text" name="buscar" value="@Request.QueryString["buscar"]" class="form-control" />
        </div>
        <div class="col-md-3">
            <label>Tipo de documento:</label>
            @Html.DropDownList("tipo", (SelectList)ViewBag.tipo, "-- Todos --", new { @class = "form-control" })
        </div>
    </div>
    <div class="row mt-2" style="margin-top: 10px; margin-bottom: 20px;">
        <div class="col-md-12">
            <button type="submit" class="btn btn-primary">Buscar</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">Limpiar Filtros</a>
        </div>
    </div>
</form>

<p>@Html.ActionLink("Crear nuevo", "Create")</p>

@if (!Model.Any())
{
    <div class="alert alert-info">No se encontraron registros.</div>
}
<table class="table">
    <tr>
        <th>Documento</th>
        <th>Nombres</th>
        <th>Apellidos</th>
        <th>Correo</th>
        <th>Teléfono</th>
        <th></th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.TipoDocumentoIdentidad.Descripcion @item.NumeroDocumento</td>
            <td>@item.Nombres</td>
            <td>@item.Apellidos</td>
            <td>@item.Correo</td>
            <td>@item.Telefono</td>
            <td>
                @Html.ActionLink("Editar", "Edit", new { id = item.PasajeroId }) |
                @Html.ActionLink("Detalles", "Details", new { id = item.PasajeroId }) |
                @Html.ActionLink("Eliminar", "Delete", new { id = item.PasajeroId })
            </td>
        </tr>
    }
</table>
