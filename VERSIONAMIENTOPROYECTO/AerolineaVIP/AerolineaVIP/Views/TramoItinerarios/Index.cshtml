@model IEnumerable<AerolineaVIP.Models.TramoItinerario>

@{
    ViewBag.Title = "Tramos de itinerario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.Partial("_TabsVuelos", "TramoItinerarios/Index")
<h2>Tramos de itinerario</h2>

<p>
    @Html.ActionLink("Crear nuevo", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Orden)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Itinerario.Referencia)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Vuelo.EstadoVueloCodigo)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Orden)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Itinerario.Referencia)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Vuelo.EstadoVueloCodigo)
        </td>
        <td>
            @Html.ActionLink("Editar", "Edit", new { id=item.TramoItinerarioId }) |
            @Html.ActionLink("Detalles", "Details", new { id=item.TramoItinerarioId }) |
            @Html.ActionLink("Eliminar", "Delete", new { id=item.TramoItinerarioId })
        </td>
    </tr>
}

</table>
