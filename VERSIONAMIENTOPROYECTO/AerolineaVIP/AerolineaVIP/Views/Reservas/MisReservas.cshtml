@model List<AerolineaVIP.Models.FilaMisReservas>
@{
    ViewBag.Title = "Mis reservas";
    int pagina = (int)ViewBag.Pagina;
    int totalPaginas = (int)ViewBag.TotalPaginas;
}

<h2>Mis reservas</h2>

<p>
    @Html.ActionLink("Buscar vuelos", "Buscar", "Vuelos", null, new { @class = "btn btn-sm btn-outline-dark" })
    @Html.ActionLink("Check-in", "Index", "CheckIn", null, new { @class = "btn btn-sm btn-outline-dark" })
    @Html.ActionLink("Comprobantes", "Index", "Comprobantes", null, new { @class = "btn btn-sm btn-outline-dark" })
</p>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-info" role="alert">@TempData["Mensaje"]</div>
}

<form method="get" class="mb-4">
    <div class="row">
        <div class="col-md-3">
            <label>Fecha de viaje desde:</label>
            <input type="date" name="desde" value="@Request.QueryString["desde"]" class="form-control" />
        </div>
        <div class="col-md-3">
            <label>Hasta:</label>
            <input type="date" name="hasta" value="@Request.QueryString["hasta"]" class="form-control" />
        </div>
        <div class="col-md-3">
            <label>Estado:</label>
            @Html.DropDownList("estado", (SelectList)ViewBag.estado, "-- Todos --", new { @class = "form-control" })
        </div>
    </div>
    @if (ViewBag.ErrorFiltro != null)
    {
        <span class="text-danger">@ViewBag.ErrorFiltro</span>
    }
    <div class="row mt-2" style="margin-top: 10px; margin-bottom: 20px;">
        <div class="col-md-12">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a href="@Url.Action("MisReservas")" class="btn btn-secondary">Limpiar Filtros</a>
        </div>
    </div>
</form>

@if (!(bool)ViewBag.HayReservas)
{
    <div class="alert alert-info">Aún no tiene reservas.</div>
    @Html.ActionLink("Buscar vuelos", "Buscar", "Vuelos", null, new { @class = "btn btn-dark" })
}
else if (Model.Count == 0)
{
    <div class="alert alert-info">No tiene reservas que coincidan con los filtros.</div>
}
else
{
    foreach (var r in Model.Where(x => x.Expira != null))
    {
        <div class="alert alert-warning py-2">La reserva @r.Codigo expira el @r.Expira.Value.ToString("dd/MM/yyyy HH:mm").</div>
    }

    <table class="table">
        <tr>
            <th>Código</th>
            <th>Fecha de viaje</th>
            <th>Ruta</th>
            <th>Pasajeros</th>
            <th>Reserva</th>
            <th>Compra</th>
            <th></th>
        </tr>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Codigo</td>
                <td>@(r.FechaViaje != null ? r.FechaViaje.Value.ToString("dd/MM/yyyy") : "")</td>
                <td>@r.Ruta</td>
                <td>@r.Pasajeros</td>
                <td>@r.EstadoReserva</td>
                <td>@r.EstadoCompra</td>
                <td>
                    @Html.ActionLink("Ver detalle", "Gestionar", new { id = r.ReservaId })
                    @if (r.EstadoReserva == "PENDIENTE")
                    {
                        @:|
                        @Html.ActionLink("Pagar", "Pagar", "Compras", new { id = r.ReservaId }, null)
                    }
                </td>
            </tr>
        }
    </table>

    <nav aria-label="Paginación">
        @if (pagina > 1)
        {
            <a href="@Url.Action("MisReservas", new { desde = Request.QueryString["desde"], hasta = Request.QueryString["hasta"], estado = Request.QueryString["estado"], pagina = pagina - 1 })">« Anterior</a>
        }
        <span class="mx-2">Página @pagina de @totalPaginas</span>
        @if (pagina < totalPaginas)
        {
            <a href="@Url.Action("MisReservas", new { desde = Request.QueryString["desde"], hasta = Request.QueryString["hasta"], estado = Request.QueryString["estado"], pagina = pagina + 1 })">Siguiente »</a>
        }
    </nav>
}
