@model AerolineaVIP.Models.GestionarReservaViewModel
@{
    ViewBag.Title = "Gestión de la reserva";
}

<h2>Reserva @Model.Codigo</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-info" role="alert">@TempData["Mensaje"]</div>
}

<div class="d-flex flex-wrap gap-3 mb-3">
    <div class="border rounded p-2 text-center" style="min-width: 150px;"><small class="text-muted d-block">Reserva</small><strong>@Model.EstadoReserva</strong></div>
    <div class="border rounded p-2 text-center" style="min-width: 150px;"><small class="text-muted d-block">Compra</small><strong>@Model.EstadoCompra</strong></div>
    <div class="border rounded p-2 text-center" style="min-width: 150px;"><small class="text-muted d-block">Pago simulado</small><strong>@Model.EstadoPago</strong></div>
</div>

<table class="table table-sm">
    <tr><th>Tramo</th><th>Vuelo</th><th>Ruta</th><th>Fecha</th><th>Horario</th><th>Pasajero</th><th>Asiento</th></tr>
    @foreach (var d in Model.Detalle)
    {
        <tr>
            <td>@d.Tramo</td>
            <td>@d.Vuelo</td>
            <td>@d.Ruta</td>
            <td>@d.Fecha.ToString("dd/MM/yyyy")</td>
            <td>@d.Horario</td>
            <td>@d.Pasajero</td>
            <td>@d.Asiento</td>
        </tr>
    }
</table>
<p><strong>Total:</strong> @Model.Total.ToString("N2") USD
    @if (Model.Expira != null)
    {
        <span class="ms-3 text-warning">Retenida hasta @Model.Expira.Value.ToString("dd/MM/yyyy HH:mm")</span>
    }
</p>

<div class="card mb-3">
    <div class="card-body">
        <h5>Condiciones de cancelación y reembolso</h5>
        <ul class="mb-2">
            <li>Una reserva pendiente de pago puede cancelarse sin costo antes de la salida del primer tramo.</li>
            <li>Una reserva pagada puede cancelarse hasta 24 horas antes de la salida, si ningún pasajero completó el check-in. Se aplica un reverso simulado del 100 % y se emite una nota de crédito académica.</li>
            <li>Solo se cancela el itinerario completo. No se realizan devoluciones de dinero reales.</li>
        </ul>
        @if (!Model.PuedeCancelar)
        {
            <div class="alert alert-secondary mb-0">@Model.MotivoNoCancelable</div>
        }
    </div>
</div>

<div class="mb-3">
    @if (Model.PuedeCancelar)
    {
        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modalCancelar">Solicitar cancelación</button>
    }
    @if (Model.EstadoReserva == "PENDIENTE")
    {
        @Html.ActionLink("Pagar", "Pagar", "Compras", new { id = Model.ReservaId }, new { @class = "btn btn-dark" })
    }
    @Html.ActionLink("Regresar", "MisReservas", null, new { @class = "btn btn-outline-dark" })
</div>

@if (Model.PuedeCancelar)
{
    <div class="modal fade" id="modalCancelar" tabindex="-1" aria-labelledby="tituloCancelar" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="tituloCancelar">Confirmar cancelación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning mb-2">
                        <strong>Advertencia:</strong> La cancelación liberará los asientos @Model.AsientosTexto. Esta acción no se puede deshacer.
                    </div>
                    @if (Model.EsPagada)
                    {
                        <p class="mb-0">Se registrará un reverso simulado de @Model.Total.ToString("N2") USD y una nota de crédito académica.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    @using (Html.BeginForm("Cancelar", "Reservas", new { id = Model.ReservaId }, FormMethod.Post, new { id = "formCancelar" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger" id="btnConfirmarCancelacion">Confirmar solicitud</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(function () {
            $('#formCancelar').on('submit', function () {
                $('#btnConfirmarCancelacion').prop('disabled', true).text('Procesando solicitud…');
            });
        });
    </script>
}
